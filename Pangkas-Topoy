    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Store Cart Items
        let cart = {};

        // Auto Set Year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Check Operating Hours Status Realtime
        function checkStatus() {
            const now = new Date();
            const hours = now.getHours();
            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');

            if (hours >= 10 && hours < 22) {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse";
                statusText.innerHTML = "<span class='text-emerald-400'>BUKA</span> (10.00 - 22.00 WIB)";
            } else {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-red-500";
                statusText.innerHTML = "<span class='text-red-400'>TUTUP</span> (Buka Jam 10.00 WIB)";
            }
        }
        checkStatus();

        // Add Item to Cart
        function addToCart(name, price) {
            if (cart[name]) {
                cart[name].qty += 1;
            } else {
                cart[name] = { price: price, qty: 1 };
            }
            updateCartUI();
            
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: `${name} ditambahkan!`,
                showConfirmButton: false,
                timer: 1500,
                background: '#1e293b',
                color: '#fff'
            });
        }

        // Remove / Clear Cart
        function clearCart() {
            cart = {};
            updateCartUI();
        }

        function updateCartUI() {
            const cartList = document.getElementById('cartList');
            const cartTotal = document.getElementById('cartTotal');
            
            const keys = Object.keys(cart);
            if (keys.length === 0) {
                cartList.innerHTML = `<p class="text-slate-500 italic">Belum ada item dipilih. Klik tombol "+ Tambah" pada daftar menu.</p>`;
                cartTotal.textContent = 'Rp 0';
                return;
            }

            let html = '';
            let total = 0;

            keys.forEach(key => {
                const item = cart[key];
                const subtotal = item.price * item.qty;
                total += subtotal;

                html += `
                    <div class="flex justify-between items-center py-1 border-b border-slate-800">
                        <span>${key} <strong class="text-amber-400">x${item.qty}</strong></span>
                        <span>Rp ${subtotal.toLocaleString('id-ID')}</span>
                    </div>
                `;
            });

            cartList.innerHTML = html;
            cartTotal.textContent = `Rp ${total.toLocaleString('id-ID')}`;
        }

        // Send to WhatsApp
        function sendWhatsApp(e) {
            e.preventDefault();

            const name = document.getElementById('custName').value.trim();
            const date = document.getElementById('custDate').value;
            const time = document.getElementById('custTime').value;
            const note = document.getElementById('custNote').value.trim();

            const cartKeys = Object.keys(cart);
            let itemSummary = '';
            let total = 0;

            if (cartKeys.length > 0) {
                itemSummary = '\n*Detail Pesanan:*\n';
                cartKeys.forEach(key => {
                    const item = cart[key];
                    const subtotal = item.price * item.qty;
                    total += subtotal;
                    itemSummary += `- ${key} (${item.qty}x) = Rp ${subtotal.toLocaleString('id-ID')}\n`;
                });
                itemSummary += `*Total Estimasi:* Rp ${total.toLocaleString('id-ID')}\n`;
            } else {
                itemSummary = '\n*Pesanan:* Layanan Pangkas Rambut\n';
            }

            const phone = "62895611001157";
            const message = `Halo PANGKAS TOPOY, saya mau booking/pesan:\n\n` +
                            `*Nama:* ${name}\n` +
                            `*Tanggal:* ${date}\n` +
                            `*Jam:* ${time} WIB\n` +
                            `${itemSummary}` +
                            (note ? `*Catatan:* ${note}\n` : '') +
                            `\nMohon konfirmasinya. Terima kasih!`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phone}?text=${encodedMessage}`, '_blank');
        }
    </script>
